__pycache__/
*.pyc
.venv/
*.db
# One-off pre-migration/pre-repair backup copies of the dev DB (e.g.
# newsflo.db.pre-task2, newsflo.db.pre-cleanup) -- *.db only matches a
# literal ".db" suffix, not these, so `git add -A` would otherwise commit
# several untracked multi-MB backup files.
*.db.*
*.db-journal
.env

# Self-hosted NLLB model weights (~1-2GB per model) -- provisioned locally
# by scripts/download_translation_model.py, never committed.
models/

# Universe ingest snapshots -- raw fetch-stage output (NSE/BSE masters, the
# ~5,000-file monthly BSE detail pass, AMFI categorisation copies), written
# at runtime by app/companies/universe/fetchers.py + snapshot.py. Never
# committed: it's regenerated daily/monthly and would flood git status with
# thousands of entries per run.
data/universe/
